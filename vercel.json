{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/zepp-sync",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/streak-reminder",
      "schedule": "0 23 * * *"
    }
  ]
}
