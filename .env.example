# Copia este archivo a .env.local solo si quieres usar tu MongoDB Atlas en desarrollo.
# Sin MONGODB_URI, `npm run dev` usa un MongoDB local que guarda los datos en .data/.
MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@TU-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=caliche-balance

# Conexión con Zepp: llave para cifrar los tokens (genera una con: openssl rand -base64 32).
ZEPP_TOKEN_KEY=
# Solo en Vercel: secreto que Vercel Cron manda para la sincronización diaria con Zepp.
CRON_SECRET=

# Notificaciones push: genera las llaves con `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# https:// de tu app en Vercel o mailto: (Apple rechaza otros valores).
VAPID_SUBJECT=https://TU-APP.vercel.app
